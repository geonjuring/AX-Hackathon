# Documentation only: this app does NOT load .env files automatically.
# Export variables in the server shell before starting the app.
# SLP_DATA=/absolute/path/to/authorized/deidentified/data
# SLP_DB=/absolute/path/to/slp.duckdb
AGENTSTREAM_API_KEY=
AGENTSTREAM_BASE_URL=https://api-gateway.jntp-ax.or.kr/agentstream
AGENTSTREAM_CHATBOT_ID=
AGENTSTREAM_WORKSPACE_ID=
# Team deployment uses 120 seconds; the client accepts 1..300.
AGENTSTREAM_TIMEOUT_SECONDS=120
AISTREAM_TIMEOUT_SECONDS=45

# Optional directory for generated reports, settings and cache
# SLP_RUNTIME=/absolute/path/to/runtime
